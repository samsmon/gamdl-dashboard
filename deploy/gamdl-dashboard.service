[Unit]
Description=gamdl dashboard
After=network-online.target

[Service]
Type=simple
# Placeholders in this template are filled in by deploy/install.sh
WorkingDirectory=@REPO@
EnvironmentFile=/etc/gamdl-dashboard.env
ExecStart=@REPO@/.venv/bin/python -m app
@USER_LINE@Restart=on-failure
KillMode=control-group
TimeoutStopSec=15
# No PrivateTmp: the gamdl-safe lock lives in the shared tmp dir, so a manual run must see it.

[Install]
WantedBy=multi-user.target
